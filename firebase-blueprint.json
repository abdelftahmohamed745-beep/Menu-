{
  "entities": {
    "venue": {
      "title": "Venue",
      "description": "Restaurant or cafe profile and branding settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "coverImage": { "type": "string" },
        "profileImage": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "openingHours": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "slug", "currency"]
    },
    "category": {
      "title": "Category",
      "description": "Menu categories for organizing products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "venueId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "venueId", "name", "displayOrder"]
    },
    "product": {
      "title": "Product",
      "description": "Dishes, drinks, and food items in the menu",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "venueId": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "filterTagIds": { "type": "array" },
        "isVisible": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "calories": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "venueId", "categoryId", "name", "price", "isVisible", "displayOrder"]
    },
    "filterTag": {
      "title": "FilterTag",
      "description": "Dynamic filter badges such as bestseller, vegetarian, spicy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "venueId": { "type": "string" },
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "color": { "type": "string" },
        "textColor": { "type": "string" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "venueId", "name", "color", "displayOrder"]
    },
    "restaurant_login_link": {
      "title": "RestaurantLoginLink",
      "description": "Magic login links for restaurant owners generated by super admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurant_id": { "type": "string" },
        "token_hash": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string" },
        "last_used_at": { "type": "string" }
      },
      "required": ["id", "restaurant_id", "token_hash", "is_active", "created_at"]
    },
    "slug_registry_item": {
      "title": "SlugRegistryItem",
      "description": "Registry of public restaurant slugs and aliases for uniqueness and redirection",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "venueId": { "type": "string" },
        "type": { "type": "string" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["slug", "venueId", "type", "isActive", "updatedAt"]
    },
    "rate_limit_item": {
      "title": "RateLimitItem",
      "description": "Distributed brute force rate limit tracking across serverless instances",
      "type": "object",
      "properties": {
        "ipHash": { "type": "string" },
        "attempts": { "type": "number" },
        "firstAttemptAt": { "type": "number" },
        "lockedUntil": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ipHash", "attempts", "firstAttemptAt", "lockedUntil", "updatedAt"]
    },
    "slug_audit_log_item": {
      "title": "SlugAuditLogItem",
      "description": "Audit log for public restaurant ID changes",
      "type": "object",
      "properties": {
        "venueId": { "type": "string" },
        "oldSlug": { "type": "string" },
        "newSlug": { "type": "string" },
        "changedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["venueId", "oldSlug", "newSlug", "changedBy", "timestamp"]
    }
  },
  "firestore": {
    "/venues/{venueId}": {
      "schema": { "$ref": "#/entities/venue" },
      "description": "Collection of restaurant and cafe venues"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/category" },
      "description": "Collection of menu categories"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/product" },
      "description": "Collection of menu products and items"
    },
    "/filterTags/{filterTagId}": {
      "schema": { "$ref": "#/entities/filterTag" },
      "description": "Collection of tags for categorizing and filtering items"
    },
    "/restaurant_login_links/{linkId}": {
      "schema": { "$ref": "#/entities/restaurant_login_link" },
      "description": "Collection of magic login links for restaurant admins"
    },
    "/slug_registry/{slug}": {
      "schema": { "$ref": "#/entities/slug_registry_item" },
      "description": "Unique index of active slugs and legacy redirect aliases"
    },
    "/rate_limits/{ipHash}": {
      "schema": { "$ref": "#/entities/rate_limit_item" },
      "description": "Persistent rate limiting records per client IP"
    },
    "/restaurant_slug_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/slug_audit_log_item" },
      "description": "Audit trail of restaurant identifier changes"
    }
  }
}
