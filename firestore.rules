rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isOwnerOf(venueId) {
      return isAuthenticated() && request.auth.token.role == 'restaurant_owner' && request.auth.token.venueId == venueId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Validation Functions
    function isValidVenueUpdate(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.currency is string && data.currency.size() > 0 && data.currency.size() <= 10
        // Forbid client writes to sensitive fields; those are handled exclusively via server APIs
        && (!('slug' in data) || data.slug == existing().slug)
        && (!('previousSlugs' in data) || data.previousSlugs == existing().previousSlugs)
        && !('adminPassword' in data)
        && !('accessCode' in data)
        && !('access_code' in data);
    }

    function isValidCategory(data, vId) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.venueId == vId
        && data.displayOrder is number;
    }

    function isValidProduct(data, vId) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.venueId == vId
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 128
        && data.price is number && data.price >= 0
        && data.isVisible is bool
        && data.displayOrder is number;
    }

    function isValidFilterTag(data, vId) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 50
        && data.venueId == vId
        && data.displayOrder is number;
    }

    // 1. Venues collection
    // Public read for customer menu; write only by Super Admin or authenticated Owner of this venue
    match /venues/{venueId} {
      allow get, list: if isValidId(venueId);
      allow create: if isSuperAdmin();
      allow update: if (isSuperAdmin() || isOwnerOf(venueId)) && isValidVenueUpdate(incoming());
      allow delete: if isSuperAdmin();
    }

    // 2. Categories collection
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isValidId(categoryId)
        && (isSuperAdmin() || isOwnerOf(incoming().venueId))
        && isValidCategory(incoming(), incoming().venueId);
      allow update: if (isSuperAdmin() || isOwnerOf(existing().venueId))
        && incoming().venueId == existing().venueId
        && isValidCategory(incoming(), existing().venueId);
      allow delete: if isSuperAdmin() || isOwnerOf(existing().venueId);
    }

    // 3. Products collection
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId)
        && (isSuperAdmin() || isOwnerOf(incoming().venueId))
        && isValidProduct(incoming(), incoming().venueId);
      allow update: if (isSuperAdmin() || isOwnerOf(existing().venueId))
        && incoming().venueId == existing().venueId
        && isValidProduct(incoming(), existing().venueId);
      allow delete: if isSuperAdmin() || isOwnerOf(existing().venueId);
    }

    // 4. Filter Tags collection
    match /filterTags/{filterTagId} {
      allow get, list: if true;
      allow create: if isValidId(filterTagId)
        && (isSuperAdmin() || isOwnerOf(incoming().venueId))
        && isValidFilterTag(incoming(), incoming().venueId);
      allow update: if (isSuperAdmin() || isOwnerOf(existing().venueId))
        && incoming().venueId == existing().venueId
        && isValidFilterTag(incoming(), existing().venueId);
      allow delete: if isSuperAdmin() || isOwnerOf(existing().venueId);
    }

    // 5. SERVER-ONLY COLLECTIONS (Client access completely blocked)
    // Only touched via Firebase Admin SDK with Service Account privileges
    match /restaurant_credentials/{document=**} {
      allow read, write: if false;
    }

    match /restaurant_login_links/{document=**} {
      allow read, write: if false;
    }

    match /rate_limits/{document=**} {
      allow read, write: if false;
    }

    match /slug_registry/{document=**} {
      allow read, write: if false;
    }

    match /restaurant_slug_audit_logs/{document=**} {
      allow read, write: if false;
    }

    match /system_health/{document=**} {
      allow read, write: if false;
    }

    match /sessions/{document=**} {
      allow read, write: if false;
    }

    match /test/{document=**} {
      allow read, write: if false;
    }
  }
}
