{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "maxDuration": 15
    },
    "api/*.mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/ping", "destination": "/api/ping" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
